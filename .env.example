# Frenzy Overseas Pvt. Ltd. - Environment Configuration
# Copy this file to .env.local to configure custom integrations.

# Sanity CMS Configuration (Optional - without these, the site uses the rich local development content adapter)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Resend Email Integration (Optional - without this, contact inquiries log to server console and return successful delivery)
RESEND_API_KEY=
EMAIL_FROM=inquiries@frenzyoverseas.in
EMAIL_TO=director@frenzyoverseas.com

# Site URL for canonical metadata & sitemap
NEXT_PUBLIC_SITE_URL=https://frenzyoverseas.in
